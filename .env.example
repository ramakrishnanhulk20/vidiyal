# Copy to .env and fill in. .env is git ignored and nothing here is ever logged.

# Read-only Bitget API credentials. Only needed to review a real account: every market
# read and the Agent Hub dry run work with all three left empty.
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# A label for the account being reviewed. It only tags the record, Bitget never sees it.
BITGET_ACCOUNT_ID=

# The Kaaval ledger directory to review. Defaults to the live ledger at
# ../kaaval/data/state/ledger, falling back to ledger-demo only when that folder is absent.
KAAVAL_LEDGER_DIR=

# The Ed25519 public key the ledger is signed with, 64 hex characters. Public half only,
# never the private key. Defaults to reading ../kaaval/data/secrets/ledger-key.pub.hex.
KAAVAL_LEDGER_PUBLIC_KEY_HEX=

# Which brain in that ledger to review. Defaults to claude.
KAAVAL_BRAIN=

# Anthropic key for the reasoning judge and the question answerer, used only when QWEN_API_KEY
# is empty. With neither key a written rationale is left ungraded and answers are written from
# the evidence table alone.
ANTHROPIC_API_KEY=

# Which Claude model to use. Defaults to claude-haiku-4-5-20251001.
KAAVAL_CLAUDE_MODEL=

# Finnhub key, free tier is enough. Without it the news feed still reads SEC EDGAR and
# GDELT, but there is no earnings or macro calendar.
FINNHUB_API_KEY=
# AskNews key for a news search across many outlets. Optional: without it the source is skipped.
# One search an hour for the whole universe, one credit each, ten articles on the Pro plan.
ASKNEWS_API_KEY=
# Set to 1 to let a review search the AskNews archive for trades older than 48 hours. Off by
# default, because a review asks about every hour ever traded and each ask is a credit.
ASKNEWS_HISTORICAL=

# The contact address SEC EDGAR asks every caller to send. Filings are refused without it.
KAAVAL_USER_AGENT=

# How long one news, SEC or GDELT request may take, headers and body together, in
# milliseconds. Defaults to 20000.
KAAVAL_HTTP_TIMEOUT_MS=

# How long one Bitget request may take, in milliseconds. The SDK retries a read twice on
# top of this. Defaults to 15000.
KAAVAL_BITGET_TIMEOUT_MS=

# Where the published record is served from, without a trailing slash. Set it and the desk
# reads bundles over HTTP from <url>/vidiyal/manifest.json and <url>/vidiyal/reviews/<name>.json
# instead of off this disk. Left empty, the desk reads data/state/reviews.
VIDIYAL_RECORD_URL=

# How the desk runs the gate and the ask: spawn, which starts the engine in its own process
# and keeps the keys out of the web server, or import, which calls the engine in the web
# process because there is no engine folder to spawn from. Defaults to spawn when the engine
# folder with its node_modules is there, and to import when it is not.
VIDIYAL_ENGINE_MODE=

# Which review bundle the desk opens, by name, matching a file in data/state/reviews and a
# name in the published manifest. Defaults to kaaval-claude.
VIDIYAL_REVIEW=

# How often the review loop rebuilds every bundle from the ledger, in minutes. Defaults to 60.
VIDIYAL_REVIEW_MINUTES=

# The file holding the 64 hex characters of the ledger public key, read when
# KAAVAL_LEDGER_PUBLIC_KEY_HEX is empty. Defaults to ../kaaval/data/secrets/ledger-key.pub.hex.
KAAVAL_LEDGER_PUBLIC_KEY_FILE=

# Qwen through Bitget's hackathon proxy, or any OpenAI-shaped endpoint. Only the alternative
# judge and answerer read these; with no key that client is never built.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
# Set to 1 to let Qwen think before it answers. Off by default: with it on one call takes about
# a minute through the proxy and the brain misses the tick.
QWEN_THINKING=

# Path to the Kaaval public key file, an alternative to pasting the hex above.
KAAVAL_LEDGER_PUBLIC_KEY_PATH=
# The folder the site reads review bundles from when VIDIYAL_RECORD_URL is not set. Defaults to ../data/state from web.
VIDIYAL_DATA_DIR=
# The engine folder the site spawns for the gate and the ask page in spawn mode. Defaults to the repo root.
VIDIYAL_ENGINE_DIR=

# The account area: sign-in, the database, and the seal a trader's Bitget key is stored
# under. The engine, the published record and every market read work with all of these
# empty; the account screens then say plainly that sign-in is not set up on this host.
# The Privy app id. Public by design, it is inlined into the browser bundle.
NEXT_PUBLIC_PRIVY_APP_ID=
# The Privy app secret. Server only. It is what proves a trader's sign-in token is real.
PRIVY_APP_SECRET=
# The Postgres connection string for the trader database, the pooled one from the Neon
# console, for example postgresql://user:pass@host-pooler.neon.tech/db?sslmode=require
# Bring it up to date with: cd web && npx tsx scripts/migrate.mts
DATABASE_URL=
# The 64 hex characters, 32 bytes, that a trader's Bitget key is sealed under before it is
# stored. Only the account review path needs it. Generate one with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` and keep it off
# every machine that holds the sealed keys' backup. The name says Kaaval and stays that way
# on purpose: Kaaval and Vidiyal share one database and one seal key, so a key connected in
# either app is readable by the other.
KAAVAL_KEY_SEAL_HEX=

# Where the sister site lives, for the one link in the footer. Defaults to https://kaaval-agent.vercel.app;
# set http://localhost:3000 when both dev servers run on one machine.
KAAVAL_URL=
